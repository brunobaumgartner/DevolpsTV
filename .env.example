# Copie para .env e ajuste os valores. NUNCA commitar o .env de verdade.

MYSQL_ROOT_PASSWORD=troque_esta_senha_root
MYSQL_DATABASE=iptv
MYSQL_USER=iptv_app
MYSQL_PASSWORD=troque_esta_senha_app

# Porta em que a API fica exposta no host
API_PORT=7678

# Login do painel de admin (cadastro de links VOD, em /admin.html). Se
# ADMIN_PASSWORD ficar em branco, uma senha aleatória é gerada e aparece nos
# logs da API na primeira subida — troque aqui assim que possível.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_esta_senha_admin
